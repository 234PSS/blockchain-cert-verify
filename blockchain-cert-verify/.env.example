# Server
PORT=3000
NODE_ENV=development
# Frontend URL used in QR codes (Vite dev server default: 5173)
PUBLIC_BASE_URL=http://localhost:5173

# File uploads
UPLOAD_DIR=./uploads
MAX_CERTIFICATE_FILE_MB=5

# Database (MySQL)
DB_HOST=localhost
DB_NAME=certificate_db
DB_USER=root
DB_PASSWORD=your_password
DB_DIALECT=mysql

# Authentication
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=24h

# Blockchain (Ganache / local Ethereum)
# Default Ganache GUI port is 7545; ganache-cli often uses 8545
GANACHE_URL=http://127.0.0.1:7545
# Use account #0 private key from Ganache (with or without 0x prefix)
PRIVATE_KEY=your_ganache_account_private_key
# Optional override — auto-loaded from src/config/contract.deployment.json after migrate
CONTRACT_ADDRESS=
