{
  "name": "blockchain-cert-verify",
  "version": "1.0.0",
  "description": "University Certificate Verification System using Blockchain",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "compile": "truffle compile",
    "migrate": "truffle migrate --network development",
    "migrate:reset": "truffle migrate --reset --network development",
    "chain": "ganache-cli",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "client:install": "cd client && npm install",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build"
  },
  "keywords": [
    "blockchain",
    "certificate",
    "verification",
    "ethereum"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.0.3",
    "ethers": "^6.12.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.53.0",
    "ganache": "^7.9.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "truffle": "^5.11.0"
  }
}
